# Server
SERVER_PORT=2334
SERVER_MODE=dev

# Database (same PostgreSQL used by Prisma)
KUN_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/kungalgame
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OAuth (KUN Galgame OAuth)
OAUTH_SERVER_URL=https://oauth.kungal.com/api/v1
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=https://www.kungal.com/auth/callback
JWT_SECRET=

# File storage (toolset archive uploads — Backblaze B2 in prod).
# The only S3-API bucket the forum uses — inline / content images all go
# through image_service (KUN_IMAGE_CLIENT_*), not a local bucket. B2 has the
# bucket-level CORS policy that lets the browser do presigned-PUT uploads
# directly. Leave empty to disable toolset uploads entirely.
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_REGION=
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Search (Meilisearch)
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Galgame Wiki service (kungal proxies read/write here)
GALGAME_WIKI_BASE_URL=http://127.0.0.1:9280/api

# Catalog service (kun-galgame-infra cmd/catalog) — the galgame detail page's
# credits + name/character reverse lookups. GET-only S2S read face; auth reuses
# OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET above (the read face needs no site
# binding). When unset the catalog proxy endpoints degrade to 503.
KUN_CATALOG_API_BASE=http://127.0.0.1:9281

# image_service — public CDN prefix used by the rewriteBanners walker
# to resolve effective_banner_hash / per-row image_hash into ready URLs.
# MUST match the wiki side's KUN_IMAGE_PUBLIC_BASE_URL exactly (no
# trailing slash).
KUN_IMAGE_PUBLIC_BASE_URL=https://image.kungal.iloveren.link

# image_service — client credentials for direct uploads from kungal
# (galgame covers / screenshots — U2). When empty, /image/galgame
# returns a clear "未配置" error instead of attempting an unauthorized
# upload. Set both ID and SECRET to enable the upload endpoint.
KUN_IMAGE_CLIENT_BASE_URL=http://127.0.0.1:9278
KUN_IMAGE_CLIENT_ID=
KUN_IMAGE_CLIENT_SECRET=

# kungal-link-live-checker — the objective gate behind "report resource
# expired" (dead → auto-expire, alive → reject false report, unknown → legacy
# fallback). When BASE_URL or API_KEY is empty the gate is OFF and reports use
# the legacy single-report-expires flow. The checker sits behind Cloudflare
# Access, so CF_ACCESS_CLIENT_ID / _SECRET (the service token) are required in
# prod; leave them empty only for a dev checker not behind CF Access.
LINK_CHECKER_BASE_URL=
LINK_CHECKER_API_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
